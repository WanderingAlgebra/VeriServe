        "prefix_token_count": 200,
        "step_number": 3,
        "text": "Step 3: Next, calculate vector $\\overrightarrow{BC}$:\n\\[\n\\overrightarrow{BC} = C - B = (-2-3, 1+4, -1-1) = (-5, 5, -2)\n\\]"
      },
      {
        "aligned_char_end": 765,
        "boundary_aligned_back": true,
        "char_end": 766,
        "char_start": 581,
        "effective_step": 4,
        "end_token_index": 276,
