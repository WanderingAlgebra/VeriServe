        "prefix_token_count": 57,
        "step_number": 2,
        "text": "Step 2: Square both sides to get rid of the outer square root: $120 - \\sqrt{x} = n^2$."
      },
      {
        "aligned_char_end": 203,
        "boundary_aligned_back": true,
        "char_end": 204,
        "char_start": 153,
        "effective_step": 3,
