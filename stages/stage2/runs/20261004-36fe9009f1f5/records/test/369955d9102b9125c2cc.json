{
  "answer": "\\left[\\frac{\\pi^2}{8}, \\frac{3\\pi^2}{2}\\right]",
  "boundaries": {
    "end": {
      "aligned_char_end": 2279,
      "boundary_aligned_back": false,
      "char_end": 2279,
